{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "x402.digital_fact.v1",
  "description": "Structural schema. Trusted source pins, unique ordered SKU facts and byte semantics require independent verification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "fact_id", "source", "results"],
  "properties": {
    "schema": { "const": "x402.digital_fact.v1" },
    "fact_id": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "title", "content_type", "content_bytes", "origin_body_sha256"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "title": { "type": "string", "minLength": 1 },
        "content_type": { "const": "text/markdown" },
        "content_bytes": { "type": "integer", "minimum": 1 },
        "origin_body_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/result" }
    }
  },
  "$defs": {
    "result": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["fact_id", "field", "op", "target", "result", "span_start", "span_end"],
          "properties": {
            "fact_id": { "type": "string", "minLength": 1 },
            "field": { "const": "contains" },
            "op": { "const": "eq" },
            "target": { "type": "string", "minLength": 1 },
            "result": { "const": "pass" },
            "span_start": { "type": "integer", "minimum": 0 },
            "span_end": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["fact_id", "field", "op", "target", "result", "code"],
          "properties": {
            "fact_id": { "type": "string", "minLength": 1 },
            "field": { "const": "contains" },
            "op": { "const": "eq" },
            "target": { "type": "string", "minLength": 1 },
            "result": { "const": "unknown" },
            "code": { "const": "not_found" }
          }
        }
      ]
    }
  }
}
